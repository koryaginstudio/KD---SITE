# Server-only key used by the protected /admin API. Never expose it to client code.
SUPABASE_SERVICE_ROLE_KEY=

# Telegram BotFather token. Store as an encrypted Cloudflare secret.
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric user or group chat IDs.
TELEGRAM_RECIPIENT_CHAT_IDS=

# Google Calendar OAuth. Keep the three OAuth values as encrypted secrets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Calendar alias or ID. "primary" uses the authorized account's main calendar.
GOOGLE_CALENDAR_ID=primary

# Public GA4 measurement ID (format G-XXXXXXXXXX). Store as a Text variable.
GOOGLE_ANALYTICS_ID=
